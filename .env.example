# Copy to .env and replace this password (10-72 bytes).
ADMIN_EMAIL=admin@word.local
ADMIN_PASSWORD=replace-with-a-long-random-password
WORD_PORT=8080
BIND_ADDRESS=127.0.0.1
# Set true when accessed over HTTPS behind your reverse proxy.
COOKIE_SECURE=false
WORD_IMAGE=ghcr.io/koinaai/word:0.1.0
# Only needed when using compose.build.yaml.
# HEROUI_PRO_ARCHIVE=/absolute/path/heroui-pro-1.0.0-beta.11.tgz
