# Required on the first start; 12–72 bytes. No default administrator password exists.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@word.local

# localhost by default; use a TLS reverse proxy for an Internet-facing service.
BIND_ADDRESS=127.0.0.1
PORT=8080
COOKIE_SECURE=false
# Comma-separated proxy IPs/CIDRs. Only these peers may provide X-Forwarded-For.
# Keep empty when clients connect directly; never trust every address.
TRUSTED_PROXIES=

# Licensed HeroUI Pro archive used only when building from source.
# Run `python3 scripts/prepare_pro_archive.py /path/to/licensed/package` first.
HEROUI_PACKAGE_PATH=.secrets/heroui-pro.tgz

# To run a published image, set its immutable digest and use `docker compose up -d --no-build`.
# WORD_IMAGE=ghcr.io/koinaai/word@sha256:<digest>
